# Database Connection String (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Secure Session Secret (At least 32 characters)
ADMIN_SESSION_SECRET=your_secure_random_session_secret_here

# Initial Administrator Provisioning Credentials (Used only on initial seeding)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=ReplaceWithStrongPassword123!
